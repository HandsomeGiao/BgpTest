{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TopoSimulator: debug sample topology",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}\\TopoSimulator\\build\\Debug\\TopoSimulator.exe",
      "args": [
        "--topology",
        "${workspaceFolder}\\TopoSimulator\\config\\sample_topology.json"
      ],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}\\TopoSimulator\\build\\Debug",
      "environment": [
        {
          "name": "VCPKG_ROOT",
          "value": "C:\\Users\\giaogiao\\AllMyLibFiles\\vcpkg"
        }
      ],
      "externalConsole": true,
      "preLaunchTask": "TopoSimulator: build Debug"
    },
    {
